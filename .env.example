# === Application ===
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# === Database (Local Docker PostgreSQL 16 by default; Neon.tech Singapore on prod) ===
DB_URL=jdbc:postgresql://localhost:5432/techcommerce
DB_USERNAME=techcommerce
DB_PASSWORD=<your_db_password_or_techcommerce_dev>
# Optional direct URL for Flyway when using Neon pooled endpoint on prod
FLYWAY_URL=

# === JWT Security (at least 32 characters for HS256) ===
JWT_SECRET=<your_jwt_secret_at_least_32_characters_long>
JWT_ACCESS_EXPIRATION_SECONDS=1200
JWT_REFRESH_EXPIRATION_SECONDS=604800

# === Google OAuth2 (leave blank in local dev if not testing Google login) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SMTP Mail (Local Mailpit on port 1025 by default; Gmail App Password on prod) ===
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@techcommerce.store
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# === Cloudinary ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === VNPay Sandbox ===
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payments/vnpay/return

# === Cloudflare Named Tunnel (prod only, https://techcommerce.store) ===
CLOUDFLARE_TUNNEL_TOKEN=
